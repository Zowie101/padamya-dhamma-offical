# Local first. Node 24.12+; npm ci, then npm start (or node --run start).
HOST=127.0.0.1
PORT=8010
DATABASE_PATH=.data/sacred-form.sqlite
# Set to your exact HTTPS address when testing through a tunnel.
PUBLIC_ORIGIN=
COOKIE_SECURE=auto
ALLOW_DEMO_SEED=true
# 'demo' uses clearly-labelled catalogue rules and sends nothing to an AI service.
# For real AI: gemini, openai or nvidia. Configure your chosen provider's key and model.
SAGE_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional dedicated Gemini vision model for shrine-photo comparison.
COMPARISON_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional cloud mode: local SQLite remains the default without DATABASE_URL.
# Use Supabase's Session pooler connection string, with URL-encoded password.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
# Optional PEM root CA if your database uses a private certificate authority.
DATABASE_CA_CERT=
# Optional admin product uploads; never put the service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-media
# Cloud mode keeps existing server-side accounts; Supabase Auth is not required.
# Do not deploy this persistent SQLite server as a Vercel Function.

# NVIDIA-hosted DeepSeek; this is a NVIDIA key, not a DeepSeek-direct key.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Groq shopping assistant (keep Gemini settings for photo comparison)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
